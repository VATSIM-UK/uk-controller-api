{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly",
    ":semanticCommitTypeAll(build)",
    ":approveMajorUpdates",
    ":enableVulnerabilityAlerts"
  ],
  "enabledManagers": ["composer", "npm", "github-actions", "nvm"],
  "timezone": "Europe/London",
  "rangeStrategy": "bump",
  "platformAutomerge": false,
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "groupName": "patch dependencies",
      "automerge": true
    },
    {
      "description": "Keep the devcontainer/test MySQL image on v8 (no v9+)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["mysql"],
      "allowedVersions": "<9"
    },
    {
      "matchManagers": ["composer"],
      "matchPackageNames": ["phpunit/phpunit", "brianium/paratest"],
      "groupName": "phpunit + paratest",
      "separateMajorMinor": false
    },
    {
      "description": "spatie/laravel-activitylog + jacobtims/filament-logger",
      "matchManagers": ["composer"],
      "matchPackageNames": ["spatie/laravel-activitylog", "jacobtims/filament-logger"],
      "groupName": "spatie/laravel-activitylog + jacobtims/filament-logger",
      "separateMajorMinor": false
    },
    {
      "matchManagers": ["composer", "npm"],
      "matchDepTypes": ["require", "dependencies"],
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": ["composer", "npm"],
      "matchDepTypes": ["require-dev", "devDependencies"],
      "semanticCommitScope": "deps-dev"
    }
  ]
}
