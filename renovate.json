{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly",
    ":semanticCommitTypeAll(build)",
    ":approveMajorUpdates"
  ],
  "enabledManagers": ["composer", "npm", "github-actions", "nvm"],
  "timezone": "Europe/London",
  "rangeStrategy": "bump",
  "platformAutomerge": false,
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "groupName": "patch dependencies",
      "automerge": true
    },
    {
      "matchManagers": ["composer"],
      "matchPackageNames": ["phpunit/phpunit", "brianium/paratest"],
      "groupName": "phpunit + paratest",
      "separateMajorMinor": false
    },
    {
      "matchManagers": ["composer", "npm"],
      "matchDepTypes": ["require", "dependencies"],
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": ["composer", "npm"],
      "matchDepTypes": ["require-dev", "devDependencies"],
      "semanticCommitScope": "deps-dev"
    }
  ]
}
